#
# GENERATED from src/coach/blocks/spec.ts by scripts/coach-blocks.mjs.
# Edit the spec, run `node scripts/coach-blocks.mjs`, and commit both.
# `npm run test` fails while this file and the spec disagree.

root ::= answer
answer ::= "{" ws "\"blocks\"" ws ":" ws blocks ws "}"
blocks ::= "[" ws block (ws "," ws block){0,5} ws "]"
block ::= block-text | block-fretboard | block-chord-shape | block-tab-excerpt | block-progress | block-take | block-compare | block-action

block-text-type-value ::= "\"text\""
sentence-240 ::= "\"" sentence-char{1,240} "\""
