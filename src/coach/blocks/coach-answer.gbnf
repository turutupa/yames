block-tab-excerpt ::= "{" ws "\"type\"" ws ":" ws block-tab-excerpt-type-value ws "," ws "\"score\"" ws ":" ws id-64 ws "," ws "\"fromBar\"" ws ":" ws int-1-9999 ws "," ws "\"toBar\"" ws ":" ws int-1-9999 ws ("," ws "\"attempt\"" ws ":" ws id-64 ws)? "}"
block-progress-type-value ::= "\"progress\""
block-progress ::= "{" ws "\"type\"" ws ":" ws block-progress-type-value ws "," ws "\"score\"" ws ":" ws id-64 ws "," ws "\"fromBar\"" ws ":" ws int-1-9999 ws "," ws "\"toBar\"" ws ":" ws int-1-9999 ws "}"
block-take-type-value ::= "\"take\""
block-take ::= "{" ws "\"type\"" ws ":" ws block-take-type-value ws "," ws "\"attempt\"" ws ":" ws id-64 ws ("," ws "\"fromBar\"" ws ":" ws int-1-9999 ws)? ("," ws "\"toBar\"" ws ":" ws int-1-9999 ws)? "}"
