block-chord-shape ::= "{" ws "\"type\"" ws ":" ws block-chord-shape-type-value ws "," ws "\"chord\"" ws ":" ws chord-name ws "," ws "\"shape\"" ws ":" ws int-0-29 ws ("," ws "\"instrument\"" ws ":" ws block-chord-shape-instrument-value ws)? "}"
block-tab-excerpt-type-value ::= "\"tabExcerpt\""
id-64 ::= "\"" [A-Za-z0-9_.:-]{1,64} "\""
