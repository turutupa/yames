block-action-action-load-jam-kind-value ::= "\"loadJam\""
block-action-action-load-jam ::= "{" ws "\"kind\"" ws ":" ws block-action-action-load-jam-kind-value ws "," ws "\"jam\"" ws ":" ws id-64 ws "}"
