block-action-action-ramp-kind-value ::= "\"ramp\""
block-action-action-ramp ::= "{" ws "\"kind\"" ws ":" ws block-action-action-ramp-kind-value ws "," ws "\"fromBpm\"" ws ":" ws int-20-300 ws "," ws "\"toBpm\"" ws ":" ws int-20-300 ws "}"
