{
  "name": "yames",
  "private": true,
  "version": "1.0.4",
  "description": "Yames — Free desktop metronome built for real practice. MIDI footswitch control, sub-millisecond precision, zen mode, speed drills, presets, AI practice coach (coming soon). Hands stay on the instrument. macOS, Windows, Linux.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://yames.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/turutupa/yames"
  },
  "keywords": [
    "metronome",
    "desktop-metronome",
    "music",
    "rhythm",
    "bpm",
    "tempo",
    "practice",
    "musician-tools",
    "practice-coach",
    "midi-footswitch",
    "adaptive-tempo",
    "tauri",
    "rust"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test --lib --no-default-features",
    "test:dsp": "cargo test --manifest-path src-tauri/Cargo.toml --test dsp_fixtures",
    "test:dsp:bake": "UPDATE_FIXTURES=1 cargo test --manifest-path src-tauri/Cargo.toml --test dsp_fixtures",
    "test:highbpm": "cargo test --manifest-path src-tauri/Cargo.toml --test highbpm_fixtures",
    "test:highbpm:bake": "UPDATE_FIXTURES=1 cargo test --manifest-path src-tauri/Cargo.toml --test highbpm_fixtures",
    "yames:debug-bpm": "bash scripts/debug-bpm.sh",
    "dev:debug-bpm": "bash scripts/dev-debug-bpm.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/plugin-global-shortcut": "~2.3.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "i18next": "^26.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.9.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3"
  }
}
